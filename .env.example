# .env.example — configuration knobs for the fully-offline voice bot.
#
# Copy to .env and uncomment/edit any line you want to override:
#
#     cp .env.example .env
#
# EVERY value below is optional: the bot ships with sensible defaults, so
# `uv run bot.py` works with zero configuration and an empty (or absent) .env.
# The shown value on each line IS the default.
#
# This file is CONFIG ONLY — model names, a voice, device indices, cache paths.
# It never holds secrets: every service is local and auth-free (Ollama pulls
# from its own registry; Whisper-MLX / Kokoro / Silero / Smart Turn download
# anonymously from HuggingFace). There are NO API keys.

# ── LLM (Ollama) ────────────────────────────────────────────────────────────
# Ollama model tag. The SAME string scripts/run_ollama.sh pulls, so the bot and
# the pull agree on which model is served. Smaller/faster: qwen2.5:7b.
#LLM_MODEL=qwen2.5:14b

# OpenAI-compatible Ollama endpoint. Note the trailing /v1 (the OpenAI-compat
# path, not the native API root).
#OLLAMA_BASE_URL=http://localhost:11434/v1

# ── STT (Whisper-MLX) ───────────────────────────────────────────────────────
# MLXModel member name. Options: TINY, MEDIUM, LARGE_V3, LARGE_V3_TURBO.
# Must match a model scripts/prefetch_models.py downloaded (it reads this var).
#WHISPER_MODEL=LARGE_V3_TURBO

# ── TTS (Kokoro) ────────────────────────────────────────────────────────────
# Kokoro voice id. e.g. af_heart, af_bella, am_michael, bf_emma. Kokoro's own
# default is None (unsynthesizable), so the bot always supplies one.
#KOKORO_VOICE=af_heart

# ── Audio devices (PyAudio indices) ─────────────────────────────────────────
# Leave unset to use the system default input/output. Run
# `uv run select_audio_device.py` (or check your OS audio settings) to find
# indices for a specific mic/speaker.
#INPUT_DEVICE_INDEX=
#OUTPUT_DEVICE_INDEX=

# ── Greeting ────────────────────────────────────────────────────────────────
# Opening line the bot speaks on startup, and the delay (seconds) before it —
# the delay lets the local audio-output stream spin up before the first frame.
#GREETING=Hi. I'm your private, offline financial thinking partner. What's on your mind today?
#GREETING_DELAY_SECS=1.0

# ── Logging ─────────────────────────────────────────────────────────────────
# Loguru level for stderr. DEBUG surfaces each service's activity — useful
# during the offline test to confirm no service silently reaches the network.
#LOG_LEVEL=DEBUG

# ── Cache directories (advanced) ────────────────────────────────────────────
# Where model weights live. Defaults steer all caches into the repo-local
# ./models/ tree so a warmed-up repo runs offline. Change only if you keep
# checkpoints elsewhere. HF_HOME must be set before any model lib imports;
# config.py handles that at import time.
#HF_HOME=./models/huggingface
#KOKORO_MODEL_PATH=./models/kokoro/kokoro-v1.0.onnx
#KOKORO_VOICES_PATH=./models/kokoro/voices-v1.0.bin

# ── Ollama server relocation (used by scripts/run_ollama.sh) ────────────────
# Point Ollama's model store into the repo (./models/ollama) and set the host
# it serves on. The bot reaches it via OLLAMA_BASE_URL above.
#OLLAMA_MODELS=./models/ollama
#OLLAMA_HOST=127.0.0.1:11434
