# Local model checkpoints (fetched via scripts/prefetch_models.py + run_ollama.sh)
models/

# Python virtual environment
.venv/

# Local config (copied from .env.example; config only, never secrets)
.env

# Python bytecode caches
__pycache__/
*.pyc

# Runtime + debug logs
*.log
ralph/logs/

# Ralph-loop / spike run-state sentinels (created at runtime under ralph/;
# these patterns are unanchored so they match at any depth)
RALPH_DONE
RALPH_BLOCKED
RALPH_BLOCKED.md
VPIO_DONE
VPIO_BLOCKED
VPIO_BLOCKED.md

# Scratch/temp
_verify_tmp.py

# Ralph-loop runtime progress journal (regenerated on each run)
PROGRESS.md

# VPIO echo-cancellation spike (kept locally, not part of the public example)
spike-vpio/
SPIKE_VPIO.md
SPIKE_FINDINGS.md
SPIKE_PROGRESS.md
ralph_vpio.sh
PROMPT_vpio.md
