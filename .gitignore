# Local model checkpoints (fetched via scripts/prefetch_models.py + run_ollama.sh)
models/

# Python virtual environment
.venv/

# locat.sh runtime state (pidfiles for the processes locat started)
.locat/

# User documents indexed by RAG
data/

# Local config (copied from env.example; config only, never secrets)
.env
.env.bak

# Python bytecode caches
__pycache__/
*.pyc

# Scratch/temp
_verify_tmp.py

# Runtime + debug logs
*.log
ralph/logs/

# Ralph-loop runtime progress journal (regenerated on each run)
PROGRESS.md