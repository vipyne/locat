# Local model checkpoints (fetched via scripts/prefetch_models.py + run_ollama.sh)
models/

# Python virtual environment
.venv/

# lofi.sh runtime state (pidfiles for the processes lofi started)
.lofi/

# User documents indexed by RAG
data/

# Local settings (copied from lofirc.example; config only, never secrets)
.lofirc
.lofirc.bak

# Hosted API keys (copied from env.example)
.env
.env.bak

# Python bytecode caches
__pycache__/
*.pyc

# Scratch/temp
_verify_tmp.py
.superpowers/

# Model-sweep eval reports (evals/sweep.sh)
evals/results/

# Runtime + debug logs
*.log
ralph/logs/

# Ralph-loop runtime progress journal (regenerated on each run)
PROGRESS.md