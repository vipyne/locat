# Local model checkpoints (fetched via scripts/prefetch_models.py + run_ollama.sh)
models/

# Python virtual environment
.venv/

# locat.sh runtime state (pidfiles for the processes locat started)
.locat/

# User documents indexed by RAG
data/

# Local settings (copied from locatrc.example; config only, never secrets)
.locatrc
.locatrc.bak

# Hosted API keys (copied from env.example)
.env
.env.bak

# Python bytecode caches
__pycache__/
*.pyc

# Scratch/temp
_verify_tmp.py
.superpowers/

# Model-sweep eval reports (evals/sweep.sh)
evals/results/

# Runtime + debug logs
*.log
ralph/logs/

# Ralph-loop runtime progress journal (regenerated on each run)
PROGRESS.md